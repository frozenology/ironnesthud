{
  "name": "ironnest-hud",
  "version": "1.0.0",
  "description": "IronNest HUD — system hotkey pulldown display with remote web control",
  "author": "IronNest",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.ironnest.hud",
    "productName": "IronNest HUD",
    "copyright": "Copyright © IronNest",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "hud.html",
      "hud.js",
      "hud-listener.js",
      "controller.js",
      "style.css",
      "icon.png",
      "ironnesthud.png",
      "ironnesthud.ico",
      "package.json"
    ],
    "protocols": [
      {
        "name": "IronNest HUD",
        "schemes": ["ironnesthud"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "ironnesthud.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "ironnesthud.ico",
      "uninstallerIcon": "ironnesthud.ico",
      "installerHeaderIcon": "ironnesthud.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IronNest HUD"
    },
    "portable": {
      "artifactName": "IronNest-HUD-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
